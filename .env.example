# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Allowed Telegram user IDs (comma-separated, for security)
ALLOWED_USER_IDS=123456789

# OpenAI Model
OPENAI_MODEL=gpt-4o

# Database
DATABASE_URL=sqlite:///openchiken.db

# Scheduler
MORNING_BRIEFING_HOUR=8       # 아침 브리핑 시각 (KST, 0~23)
REMINDER_MINUTES_BEFORE=15    # 일정 리마인더 몇 분 전 (기본 15분)

# iMessage (macOS 전용)
# ENABLED_CHANNELS 에 imessage 를 추가하면 활성화됩니다
# IMESSAGE_ALLOWED_HANDLES=+821012345678,user@example.com  # 허용 핸들 (미설정 시 전체 허용)
# IMESSAGE_POLL_INTERVAL=3                                 # 폴링 간격(초)
# IMESSAGE_DB_PATH=~/Library/Messages/chat.db              # chat.db 경로 (기본값 사용 권장)
